# Required
BITBUCKET_TOKEN=your_token_or_app_password
BITBUCKET_WORKSPACE=your-workspace

# Single repo:
BITBUCKET_REPO_SLUG=your-repo

# Or multiple repos (comma-separated):
# BITBUCKET_REPO_SLUGS=repo-a,repo-b

# Optional: when set, auth uses Basic (username + App Password).
# When omitted, auth uses Bearer token.
# BITBUCKET_USERNAME=your-bitbucket-username

# Optional CI gate: none | low | medium | high
# BITBUCKET_METRICS_FAIL_ON=high
