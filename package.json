{
  "name": "bitbucket-pr-metrics",
  "version": "1.0.0",
  "description": "Aggregate Bitbucket PR delivery metrics (TTFR, review cycle, lead time) without individual attribution",
  "type": "module",
  "bin": {
    "bitbucket-pr-metrics": "./dist/index.js"
  },
  "scripts": {
    "analyze": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "selfcheck": "tsx src/selfcheck.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bitbucket",
    "metrics",
    "pull-request",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
